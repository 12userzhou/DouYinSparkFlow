# DouYinSparkFlow 环境变量配置
# 复制本文件为 .env，把下面的占位值换成你在 GitHub Secret 里配置的相同内容。
# 配置生成器: docs/配置生成器使用.md

# ===== Variables（普通变量，对应 GitHub Actions 的 Environment Variables）=====

# 消息模板，[API] 会被替换成一言内容
MESSAGE_TEMPLATE=[盖瑞]今日火花[加一]\n—— [右边] 每日一言 [左边] ——\n[API]

# 一言类型（多个用逗号或 JSON 数组）
HITOKOTO_TYPES=["文学","影视","诗词","哲学"]

# 匹配模式: nickname=按好友昵称匹配; short_id=按抖音号/ShortId 匹配
MATCH_MODE=short_id

# 浏览器操作超时（毫秒）
BROWSER_TIMEOUT=120000

# 好友列表加载等待时间（毫秒）
FRIEND_LIST_WAIT_TIME=2000

# 任务重试次数
TASK_RETRY_TIMES=3

# 日志级别: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=DEBUG

# ===== Secrets（敏感信息，对应 GitHub Actions 的 Environment Secrets）=====

# 任务列表（JSON 数组）
# 每个 task 含 username(备注名), unique_id(唯一标识), targets(目标好友列表)
# targets 里的值要和 MATCH_MODE 对应：
#   - MATCH_MODE=nickname   -> targets 填好友的【昵称】
#   - MATCH_MODE=short_id   -> targets 填好友的【抖音号】或【ShortId(纯数字)】
TASKS=[{"username":"账号备注名","unique_id":"u1","targets":["好友抖音号A","好友抖音号B"]}]

# Cookie（每个用户一条，key 必须是 COOKIES_<UNIQUE_ID 大写>）
# 从浏览器开发者工具导出的 Cookie JSON 数组
COOKIES_U1=[{"name":"sessionid","value":"替换成真实值","domain":".douyin.com","path":"/"}]
